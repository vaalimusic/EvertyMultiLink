<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Top Header: Logo + Brand + Device Mode Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/app_logo"
                android:contentDescription="Everty Logo"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EVERTY MULTILINK"
                    android:textColor="@color/accent_cyan"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Native Multi-Route Proxy Core"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/badgeDeviceMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 Телефон"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/card_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp" />
        </LinearLayout>

        <!-- Update Alert Banner (shows when GitHub release is available) -->
        <LinearLayout
            android:id="@+id/bannerUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvUpdateBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/update_available"
                android:textColor="@color/accent_mint"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnUpdateBannerAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_update"
                android:textColor="@color/bg_dark"
                android:background="@drawable/card_background"
                android:backgroundTint="@color/accent_mint"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center: Big Circular Connect Button -->
        <FrameLayout
            android:id="@+id/frameConnectCircle"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_connect_circle_off"
            android:focusable="true"
            android:clickable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:nextFocusDown="@+id/btnHomeLanSync">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivPowerIcon"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/ic_power"
                    app:tint="@color/accent_cyan"
                    android:contentDescription="Power Icon"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvConnectAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ПОДКЛЮЧИТЬ"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvConnectHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Нажмите для старта"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Status & Timer Display -->
        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● ОТКЛЮЧЕНО"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvConnectionTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/accent_cyan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvCurrentIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Прямой интернет"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp" />

        <!-- Active Mode / Pinned Node Card -->
        <LinearLayout
            android:id="@+id/cardActiveMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvModeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ Режим: Multi-Link (Умный)"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badgeActiveNodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="81 узел"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/card_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvModeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Автоматическая балансировка и выбор наилучшего маршрута без привязки к одному серверу."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <!-- Pinned Node alert (visible only if a server is forced) -->
            <LinearLayout
                android:id="@+id/layoutPinnedServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1E293B"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvPinnedServerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📌 Зафиксирован: US-UltraFast"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetPin"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Снять"
                    android:textColor="@color/accent_orange"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Mode Selector Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeSmart"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="⚡ Умный"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_primary_selector"
                    app:backgroundTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeFastest"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🚀 Быстрый"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_secondary_selector"
                    app:backgroundTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeBalance"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="⚖️ Баланс"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_secondary_selector"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHomeLanSync"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="📥 Принять по QR"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_secondary_selector"
                app:backgroundTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHomeShareQr"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="📤 Поделиться"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_secondary_selector"
                app:backgroundTint="@null" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeScanQr"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📷 Сканировать QR-код камерой"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:background="@drawable/btn_secondary_selector"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>
