<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="МАРШРУТИЗАЦИЯ И ПРАВИЛА"
            android:textColor="@color/accent_mint"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="16dp" />

        <!-- 1. Split RU Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🇷🇺 Прямой доступ для РФ"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Сайты .ru, .рф, банки, Госуслуги, Кинопоиск, Яндекс идут напрямую на максимальной скорости"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSplitRu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Custom User Rules Card (like PC!) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Свои правила для сайтов и IP"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Добавляйте домены или IP, чтобы пускать их напрямую или через VPN"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginBottom="12dp" />

            <!-- Add Rule Inputs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etNewRulePattern"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:hint="домен или IP (напр. rutracker.org)"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@drawable/card_background"
                    android:paddingHorizontal="10dp"
                    android:textSize="12sp"
                    android:singleLine="true" />

                <Spinner
                    android:id="@+id/spinnerRuleAction"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/card_background" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddRule"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="➕ Добавить правило"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/bg_dark"
                android:textAllCaps="false"
                android:background="@drawable/btn_primary_selector"
                app:backgroundTint="@null"
                android:layout_marginBottom="12dp" />

            <!-- Custom Rules List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCustomRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <!-- 3. Per-App Split Tunneling (Applications) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 Разделение по приложениям"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Настройте, какие приложения на телефоне пускать через VPN"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPerAppVpn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPerAppSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <RadioGroup
                    android:id="@+id/rgPerAppMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <RadioButton
                        android:id="@+id/rbPerAppInclude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Пускать через VPN только выбранные"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbPerAppExclude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Все приложения, кроме выбранных"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectApps"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Выбрать приложения (0 выбрано)"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_secondary_selector"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Subscriptions Auto-Update Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="16dp"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 Автообновление подписок"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Автоматически проверять и подтягивать актуальные серверы и ключи при запуске"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoUpdateSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 5. DNS & Core Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Сведения о ядре и сети"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Прокси-ядро: Mihomo Core (v1.19.33 Native arm64)\n• Сетевой стек: gVisor / in-process Tun2Socks JNI\n• DNS Резолвер: 1.1.1.1, 8.8.8.8, 77.88.8.8 (Fake-IP)\n• Протоколы: VLESS + XTLS Reality + Vision"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- 6. Boosty Donate Card (Animated) -->
        <LinearLayout
            android:id="@+id/cardBoostyDonate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivBoostyHeart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_boosty_heart"
                android:contentDescription="Boosty Heart"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBoostyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/donate_title"
                    android:textColor="#F1C25C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBoostyDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/donate_desc"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Donate"
                app:tint="#F1C25C" />
        </LinearLayout>

        <!-- App Updates Card -->
        <LinearLayout
            android:id="@+id/cardAppUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/stat_sys_download_done"
                android:contentDescription="Update App"
                android:layout_marginEnd="14dp"
                app:tint="@color/accent_cyan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppUpdateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppUpdateDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_checking"
                    android:textColor="@color/accent_mint"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAppUpdateAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_check_update"
                android:textColor="@color/text_primary"
                android:background="@drawable/card_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 7. Everty OpenSource Ecosystem Link Card -->
        <LinearLayout
            android:id="@+id/cardOpenSourceLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_opensource"
                android:contentDescription="Everty OpenSource Logo"
                android:layout_marginEnd="14dp"
                app:tint="@color/accent_mint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/opensource_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/opensource_desc"
                    android:textColor="@color/accent_mint"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Open Link"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- 8. GitHub Project Link Card -->
        <LinearLayout
            android:id="@+id/cardGithubLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_tv_focusable"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="28dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_github"
                android:contentDescription="GitHub Logo"
                android:layout_marginEnd="14dp"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/github_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/github_desc"
                    android:textColor="@color/accent_mint"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Open Link"
                app:tint="@color/text_muted" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
