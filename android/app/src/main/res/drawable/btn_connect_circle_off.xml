<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#162E27" />
            <stroke
                android:width="6dp"
                android:color="@color/accent_mint" />
            <size
                android:width="200dp"
                android:height="200dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#1F2833" />
            <stroke
                android:width="5dp"
                android:color="@color/accent_mint" />
            <size
                android:width="200dp"
                android:height="200dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bg_card" />
            <stroke
                android:width="4dp"
                android:color="@color/border_card" />
            <size
                android:width="200dp"
                android:height="200dp" />
        </shape>
    </item>
</selector>
